# ── Okta OIDC (SSO) ────────────────────────────────────────────────────────────
OKTA_DOMAIN=https://<your-okta-domain>.okta.com
OKTA_ISSUER=https://<your-okta-domain>.okta.com/oauth2/default
OKTA_CLIENT_ID=<your-oidc-app-client-id>
OKTA_CLIENT_SECRET=<your-oidc-app-client-secret>

# ── Okta Management API (provisioning, groups) ─────────────────────────────────
# Generate at: Security → API → Tokens
OKTA_API_TOKEN=<your-okta-api-token>

# ── Session ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<strong-random-secret>

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/okta-iam

# ── Token audience (default authorization server = api://default) ──────────────
OKTA_AUDIENCE=api://default

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
